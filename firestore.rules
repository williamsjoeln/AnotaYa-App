rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can ONLY read and write their own financial records
    match /user_finances/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Deny all other unauthenticated access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
