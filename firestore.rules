rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuario SOLO puede leer, crear, modificar o eliminar sus propios registros (RLS estricto)
    match /user_finances/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Proteger cualquier subcolección anidada bajo el UID del usuario
      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Regla de Oro Zero Trust: Bloquear lectura y escritura a cualquier otra colección o documento
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
